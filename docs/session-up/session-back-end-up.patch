+    @Test
+    void lockOrderRemainsScheduleThenHorseThenSession() {
+        service.completeSession(SESSION_ID, validRequest(), ACTOR_ID);
+
+        var order = inOrder(coordinator, sessions, sessionRules, entityManager);
