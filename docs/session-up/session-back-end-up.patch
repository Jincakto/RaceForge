+package com.raceforge.backend.training.entity;
+
+import com.raceforge.backend.account.entity.User;
+import com.raceforge.backend.medical.entity.MedicalRecord;
+import jakarta.persistence.*;
+import java.time.LocalDateTime;
+import java.util.Arrays;
+import java.util.List;
+import org.hibernate.annotations.JdbcTypeCode;
+import org.hibernate.type.SqlTypes;
+
+/**
+ * Immutable post-training observations plus the independently updated veterinary review state.
+ * The session key enforces one assessment per session. No schema is generated by this entity.
+ */
+@Entity
+@Table(name = "Training_Session_Assessment")
+public class TrainingSessionAssessment {
+    @Id
+    @Column(name = "session_id", length = 20, updatable = false)
+    private String sessionId;
+
+    @MapsId
+    @OneToOne(fetch = FetchType.LAZY, optional = false)
+    @JoinColumn(name = "session_id", nullable = false)
+    private TrainingSession session;
+
+    @Column(name = "checklist_version", nullable = false, length = 40)
+    private String checklistVersion;
+
+    @Column(name = "passed_count", nullable = false)
